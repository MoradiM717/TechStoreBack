# Local (non-Docker) defaults. `docker compose up` overrides the two URLs below
# with the in-network service names — see the `backend` service in docker-compose.yml.
DATABASE_URL=postgresql://techstore:techstore@localhost:5433/techstore
ELASTICSEARCH_URL=http://localhost:9200

# Change this before deploying anywhere real. Every issued admin token is signed with it.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origins allowed to call the API (storefront, admin panel).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Where uploaded images are served from when S3 isn't configured.
PUBLIC_BASE_URL=http://localhost:8000
MEDIA_ROOT=media

# Leave S3_ACCESS_KEY / S3_SECRET_KEY blank to store uploads on local disk instead.
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET=techstore-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
