# Copy to .env.production and fill in. Never commit the filled copy.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- database -------------------------------------------------------------
POSTGRES_USER=techstore
POSTGRES_DB=techstore
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# --- auth -----------------------------------------------------------------
# Generate: openssl rand -hex 32
# Changing this invalidates every signed-in admin session.
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- public URLs ----------------------------------------------------------
# This API's own public address, used to build image URLs.
PUBLIC_BASE_URL=https://api.example.com

# Origins allowed to call this API. The storefront and admin origins from the
# TechStoreFront deployment, comma separated. Without these the browser blocks
# every request and the storefront looks broken with no error in the API log.
CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# --- sizing ---------------------------------------------------------------
BACKEND_WORKERS=4
ES_JAVA_OPTS=-Xms1g -Xmx1g

# --- object storage (optional) --------------------------------------------
# Leave blank to keep uploaded images on the `media` volume. Required if you
# ever run more than one backend container.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
